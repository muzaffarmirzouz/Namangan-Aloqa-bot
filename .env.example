# BotFather'dan olingan bot tokeni
BOT_TOKEN=8967756985:AAHqgJNgnPLrMYZZ9_DI7F5q9ZtvG2Rs56Q:AAExampleTokenHere

# Admin(lar)ning shaxsiy Telegram foydalanuvchi ID'si (guruh SHART EMAS —
# murojaat va videolar to'g'ridan-to'g'ri shu odam(lar)ning botga shaxsiy
# yozishmasiga keladi). Bir nechta admin bo'lsa vergul bilan ajrating.
# ID'ni bilish uchun @userinfobot ga yozing. Har bir admin botga kamida bir
# marta /start bosishi SHART (aks holda bot unga xabar yubora olmaydi).
ADMIN_IDS=123456789

# Majburiy obuna tekshiriladigan kanal username'i (@ belgisisiz)
CHANNEL_USERNAME=namanganliklar_uz

# Majburiy obuna yoqilsinmi (true/false)
REQUIRE_SUBSCRIPTION=true

# Video narx oralig'i (so'mda)
MIN_VIDEO_PRICE=10000
MAX_VIDEO_PRICE=30000

# SQLite fayl nomi (Railway'da persistent volume ulasangiz shu papkaga ko'rsating)
DB_PATH=bot.db
